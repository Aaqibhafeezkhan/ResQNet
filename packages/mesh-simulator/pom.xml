<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.resqnet</groupId>
    <artifactId>resqnet-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>mesh-simulator</artifactId>
  <packaging>jar</packaging>
  <name>ResQNet Mesh Simulator</name>
  <description>
    Deterministic discrete-event simulator for the ResQNet mesh. Drives the very
    same dev.resqnet.mesh.routing.MeshRouter used on Android over synthetic
    radios so routing correctness, failure recovery and delivery latency can be
    reproduced exactly from a seed.
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <exec.mainClass>dev.resqnet.mesh.simulator.SimulatorCli</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.resqnet</groupId>
      <artifactId>mesh-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${exec.mainClass}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>