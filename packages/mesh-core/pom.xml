<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.resqnet</groupId>
    <artifactId>resqnet-parent</artifactId>
    <version>0.2.0-beta</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>mesh-core</artifactId>
  <packaging>jar</packaging>
  <name>ResQNet Mesh Core</name>
  <description>
    Platform independent ResQNet routing engine: protocol envelopes, binary
    codec, controlled-flooding multi-hop forwarding, deduplication, hop/expiry
    enforcement, end-to-end acknowledgements, persistent store-and-forward
    coordination and offline advisory triage.

    Deliberately free of Android and framework dependencies so the exact same
    engine runs on the handset and inside the deterministic simulator.
  </description>

  <dependencies>
    <!--
      HPKE only: Tink supplies the vetted X25519 HKDF-SHA256 AES-256-GCM
      implementation and keyset parsing. ResQNet never implements a primitive or
      samples a nonce itself.
    -->
    <dependency>
      <groupId>com.google.crypto.tink</groupId>
      <artifactId>tink</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>