<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.resqnet</groupId>
  <artifactId>resqnet-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ResQNet Parent</name>
  <description>
    ResQNet - decentralized offline-first emergency communication network.
    Aggregator for the pure-Java mesh core, the deterministic mesh simulator and
    the Spring Boot coordination gateway.
  </description>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <modules>
    <module>packages/mesh-core</module>
    <module>packages/mesh-simulator</module>
    <module>services/backend</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <junit.version>5.11.4</junit.version>
    <assertj.version>3.27.3</assertj.version>
    <spring.boot.version>3.5.9</spring.boot.version>
    <springdoc.version>2.8.9</springdoc.version>

    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
    <maven.failsafe.plugin.version>3.5.2</maven.failsafe.plugin.version>
    <!-- Integration tests need a live PostgreSQL; see the failsafe config. -->
    <skipITs>true</skipITs>
    <maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.resqnet</groupId>
        <artifactId>mesh-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.resqnet</groupId>
        <artifactId>mesh-simulator</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <!--
              -parameters is required, not optional. Spring resolves @RequestParam
              and @PathVariable by parameter name at runtime; without it the
              compiled classes do not retain those names and every such endpoint
              fails at request time with a 400.
            -->
            <compilerArgs>
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
          <configuration>
            <argLine>-Xmx1g -Djava.awt.headless=true</argLine>
            <!--
              Use the class directory, not the packaged artifact.

              spring-boot:repackage replaces the project artifact with an
              executable jar whose classes live under BOOT-INF/classes. Plain
              classloading cannot read that layout, so without this the forked
              test JVM fails to resolve project classes and reports
              "ClassSelector resolution failed / NoClassDefFoundError" for
              classes that are present on disk. Naming the directory removes the
              ambiguity.
            -->
            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven.failsafe.plugin.version}</version>
          <!--
            Integration tests are opt-in, and the flag defaults to off.

            failsafe runs on `mvn verify`, so without this an ordinary build
            picks up every integration test class. The PostgreSQL ones need a
            live server that a developer or a plain CI job does not have, and
            the failure mode was a JUnit discovery error that looked like a
            broken test suite rather than a missing database.

            A test that needs external infrastructure should have to ask for
            it. Enable by setting the skipITs property to false.
          -->
          <configuration>
            <skipITs>${skipITs}</skipITs>
            <!-- See the surefire note: the repackaged jar is not loadable. -->
            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>