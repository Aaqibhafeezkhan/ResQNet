# ---------------------------------------------------------------------------
# ResQNet monorepo ignore rules
# ---------------------------------------------------------------------------

# ---- Secrets & local configuration ----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
*.p12
secrets/
local.properties

# ---- Java / Maven ----------------------------------------------------------
target/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
release.properties
.mvn/timing.properties
.mvn/timing.properties.asc
hs_err_pid*
replay_pid*

# ---- Gradle / Android ------------------------------------------------------
.gradle/
build/
app/build/
captures/
.cxx/
*.apk
*.aab
*.dex
# Anchored. Unanchored, this also matched docs/release/, which silently
# excluded the published release notes and installation guide.
/release/
*.hprof

# ---- Node / Frontend -------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
coverage/
storybook-static/

# ---- Local databases & tool state ------------------------------------------
*.db
*.sqlite
*.sqlite3
postgres-data/
.h2/

# ---- Simulated / generated artifacts --------------------------------------
/tmp/
/artifacts/
benchmark-output/
*.ndjson.gz

# ---- IDE / OS --------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.idea/

# ---- OS / misc -------------------------------------------------------------
.cache/
.direnv/
# ---- Ori agent workspace ----------------------------------------------
.ori/
