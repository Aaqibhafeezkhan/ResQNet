# Copy to .env and fill in. Never commit the filled-in file.

# Signing secret for responder tokens. Generate with: openssl rand -base64 48
RESQNET_JWT_SECRET=

# Shared token a gateway device presents when synchronising.
# Generate with: openssl rand -hex 32
RESQNET_GATEWAY_TOKEN=

# Origins allowed to call the API from a browser.
RESQNET_ALLOWED_ORIGINS=http://localhost:5173
