<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up. The message queue can contain a survivor's location
     and distress text, and the device identity is a key that must never leave
     the keystore of the device it belongs to. -->
<full-backup-content>
    <exclude domain="database" path="resqnet.db" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
