    <string name="sos_direct">One device</string>
    <string name="sos_attach_location">Attach my location to this message</string>
    <string name="sos_send">Send</string>
    <string name="sos_confirm_title">Send this emergency message?</string>
    <string name="sos_confirm_body">It will go to every phone in range and be relayed onwards by
        anyone who can. Anyone nearby will see it as an SOS.</string>
    <string name="sos_confirm_yes">Send now</string>
    <string name="sos_confirm_no">Go back</string>
    <string name="sos_sent">Message sent to the mesh</string>
    <string name="sos_sent_no_peers">No devices in range yet — the message is saved and goes out the
        moment someone appears</string>
    <string name="sos_character_count">%1$d / %2$d</string>
    <string name="sos_triage_label">Advisory triage</string>

