    <!-- Nearby -->
    <string name="nearby_title">Nearby devices</string>
    <string name="nearby_scanning">Looking for devices in range…</string>
    <string name="nearby_empty">No other ResQNet devices nearby yet. Keep this screen open, or
        turn the mesh on from Home.</string>
    <string name="nearby_unverified">Unverified</string>
    <string name="nearby_verified">Verified</string>
    <string name="nearby_verify_action">Verify</string>
    <string name="nearby_block_action">Block</string>
    <string name="nearby_compare_code">Compare this code</string>
    <string name="nearby_verify_title">Compare both screens</string>
    <string name="nearby_verify_body">Ask the other person to read out the code on their screen. If
        the two match, tap Verify. If they do not, do not send anything sensitive.</string>
    <string name="nearby_verify_confirm">Codes match — verify</string>
    <string name="nearby_verify_cancel">Cancel</string>

    <!-- Settings -->
    <string name="settings_title">Settings</string>
    <string name="settings_mesh_running">Mesh running</string>
    <string name="settings_mesh_stopped">Mesh stopped</string>
    <string name="settings_identity">This device</string>
    <string name="settings_identity_code">Your verification code</string>
    <string name="settings_identity_fingerprint">Key fingerprint</string>
    <string name="settings_hardware_backed">Key held in secure hardware</string>
    <string name="settings_hardware_software">Key held in the system keystore (no hardware backing
        detected)</string>
    <string name="settings_location">Attach location to messages</string>
    <string name="settings_location_summary">Off by default. Location is only sent when you attach
        it to a specific message.</string>
    <string name="settings_triage">Advisory triage suggestions</string>
    <string name="settings_triage_summary">Classifies message text on this device. Suggestions only
        — never used to dispatch anyone.</string>
    <string name="settings_reset_identity">Reset this device identity</string>
    <string name="settings_reset_identity_summary">Generates a new key. Every verification you have
        made will need to be repeated.</string>
    <string name="settings_reset_confirm_title">Reset this device identity?</string>
    <string name="settings_reset_confirm_body">A new key means a new device identity. Other devices
        will stop recognising this one and you will need to verify again. Messages that have already
        been sent cannot be recalled.</string>
    <string name="settings_about_limitations">Limitations</string>
    <string name="settings_about_limitations_body">Android can suspend or stop any app, including
        this one. Messages you have sent are saved on this device and go out when the mesh is running
        again, but ResQNet cannot promise to be always connected. It is experimental software and
        is not a replacement for emergency services.</string>

