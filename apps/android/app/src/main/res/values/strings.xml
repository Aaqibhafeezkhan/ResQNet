<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ResQNet</string>
    <string name="tagline">Offline emergency messaging</string>

    <!-- Welcome -->
    <string name="welcome_headline">When the network is gone, this still works.</string>
    <string name="welcome_body">ResQNet lets phones in radio range pass emergency messages to each
        other directly, with no internet, no cell tower and no account. If someone is out of range,
        their phone relays for you.</string>
    <string name="welcome_permissions_title">Two permissions, and why</string>
    <string name="welcome_permission_nearby">Nearby devices — ResQNet connects directly to phones
        around you. Nothing is sent to a server.</string>
    <string name="welcome_permission_location">Location — optional. Only attached when you choose to
        attach it to a specific message.</string>
    <string name="welcome_continue">Continue</string>
    <string name="welcome_not_now">Not now</string>
    <string name="welcome_emergency_notice">If someone is in immediate danger, call your local
        emergency number. ResQNet is not a replacement for emergency services.</string>

    <!-- Home -->
    <string name="home_sos">Send SOS</string>
    <string name="home_nearby">Nearby devices</string>
    <string name="home_inbox">Inbox</string>
    <string name="home_history">Delivery history</string>
    <string name="home_settings">Settings</string>
    <string name="home_mesh_on">Mesh running</string>
    <string name="home_mesh_off">Mesh stopped</string>
