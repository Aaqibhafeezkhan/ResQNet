<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:orientation="vertical"
    android:padding="@dimen/space_m">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/nearby_verify_title"
        android:textAppearance="@style/TextAppearance.ResQNet.Display" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/nearby_verify_body"
        android:textAppearance="@style/TextAppearance.ResQNet.Body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_compare_code"
            android:textAppearance="@style/TextAppearance.ResQNet.Section" />

        <TextView
            android:id="@+id/peerCodeLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:fontFamily="monospace"
            android:textColor="@color/network_cyan"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/peerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/verifyConfirm"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginBottom="@dimen/space_s"
        android:text="@string/nearby_verify_confirm" />

    <Button
        android:id="@+id/verifyCancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginBottom="@dimen/space_l"
        android:text="@string/nearby_verify_cancel" />
</LinearLayout>
