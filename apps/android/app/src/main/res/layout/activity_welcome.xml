<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:id="@+id/welcomeEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textAppearance="@style/TextAppearance.ResQNet.Section" />

        <TextView
            android:id="@+id/welcomeHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/welcome_headline"
            android:textAppearance="@style/TextAppearance.ResQNet.Display" />

        <TextView
            android:id="@+id/welcomeBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/welcome_body"
            android:textAppearance="@style/TextAppearance.ResQNet.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_permissions_title"
                android:textAppearance="@style/TextAppearance.ResQNet.Section" />

            <TextView
                android:id="@+id/permissionNearby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/welcome_permission_nearby"
                android:textAppearance="@style/TextAppearance.ResQNet.Body" />

            <TextView
                android:id="@+id/permissionLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/welcome_permission_location"
                android:textAppearance="@style/TextAppearance.ResQNet.Body" />
        </LinearLayout>

        <TextView
            android:id="@+id/welcomeEmergencyNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_status_chip_pending"
            android:padding="@dimen/space_m"
            android:text="@string/welcome_emergency_notice"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/welcomeContinue"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/welcome_continue" />

        <Button
            android:id="@+id/welcomeNotNow"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="@string/welcome_not_now" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
