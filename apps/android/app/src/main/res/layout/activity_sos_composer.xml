<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_m"
    android:paddingEnd="@dimen/space_m">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/sos_title"
        android:textAppearance="@style/TextAppearance.ResQNet.Display" />

    <TextView
        android:id="@+id/characterCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="end"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/messageBody"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="@dimen/space_s"
        android:background="@drawable/bg_card"
        android:gravity="top|start"
        android:hint="@string/sos_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="4096"
        android:padding="@dimen/space_m"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_disabled"
        android:textSize="18sp" />

    <RadioGroup
        android:id="@+id/scopeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/scopeBroadcast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="@dimen/touch_min"
            android:text="@string/sos_broadcast" />

        <RadioButton
            android:id="@+id/scopeDirect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:minHeight="@dimen/touch_min"
            android:text="@string/sos_direct" />
    </RadioGroup>

    <TextView
        android:id="@+id/directTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/network_cyan"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/attachLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_min"
            android:text="@string/sos_attach_location" />
    </LinearLayout>

    <TextView
        android:id="@+id/triageLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/sendButton"
        style="@style/Widget.ResQNet.SosButton"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_l"
        android:text="@string/sos_send" />
</LinearLayout>
